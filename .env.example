# Copy this file to `.env` and fill in your own Supabase project's values
# (Supabase dashboard → Settings → API) to turn on cloud sync + multi-device
# access. Leave `.env` absent (or these two blank) and the app runs fully
# offline on Dexie/IndexedDB instead — see `src/data/supabase/client.ts`
# and `README.md`'s "Cloud sync" section for the full setup steps.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
